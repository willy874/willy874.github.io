---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { SITE, LANG_MAP } from '../lib/seo';
import { PROFILE } from '../lib/profile';

export interface Props {
  title: string;
  description?: string;
  /** OG 圖片(相對站台根的路徑,如 /images/og.png) */
  ogImage?: string;
  /** OG 圖片的替代文字 */
  ogImageAlt?: string;
  /** 文章頁設 true,輸出 og:type=article */
  article?: boolean;
  /** 是否隱藏站台 Header/Footer(給全螢幕頁用) */
  bare?: boolean;
  /** 內容語系,對應 content schema 的 lang */
  lang?: keyof typeof LANG_MAP;
  /** 轉址 stub 之類不該被索引的頁面設 true */
  noindex?: boolean;
  /** article:published_time / dateModified */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** schema.org JSON-LD(已由 lib/seo.ts 的 graph() 組好) */
  jsonLd?: object;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  ogImageAlt,
  article = false,
  bare = false,
  lang = 'zh-Hant',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const siteName = SITE.name;
const fullTitle = title === siteName ? title : `${title}｜${siteName}`;
const langInfo = LANG_MAP[lang] ?? LANG_MAP['zh-Hant'];

// canonical 一律帶尾斜線(build.format 為 directory,實際檔案即 /path/index.html),
// 避免 /posts/x 與 /posts/x/ 被視為兩個網址。
const pathname = Astro.url.pathname;
const normalizedPath =
  pathname === '/' || /\.[a-z0-9]+$/i.test(pathname)
    ? pathname
    : pathname.replace(/\/?$/, '/');
const canonical = new URL(normalizedPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={langInfo.html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${PROFILE.penName}（${PROFILE.name}）`} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <!-- §7.3 OG / Twitter -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt ?? fullTitle} />
    <meta property="og:locale" content={langInfo.locale} />
    {
      article && publishedTime && (
        <>
          <meta
            property="article:published_time"
            content={publishedTime.toISOString()}
          />
          <meta
            property="article:modified_time"
            content={(modifiedTime ?? publishedTime).toISOString()}
          />
          <meta property="article:author" content={PROFILE.penName} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? fullTitle} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href="/rss.xml"
    />

    <!-- §7.3 結構化資料 -->
    {jsonLd && <JsonLd data={jsonLd} />}

    <!-- §6.1 Noto Sans TC + JetBrains Mono,font-display: swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />

    <!-- §6.3 主題切換 script:置於 head 最前,避免 FOUC -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <div class="flex min-h-dvh flex-col">
          <Header />
          <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
            <slot />
          </main>
          <Footer />
        </div>
      )
    }
  </body>
</html>
